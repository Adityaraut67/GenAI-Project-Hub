# Copy this file to .env and fill in ONE provider. Never commit the real .env.

# ---------------------------------------------------------------------------
# Provider — set the key for ONE of these. Groq wins if both are present.
# ---------------------------------------------------------------------------
GROQ_API_KEY=gsk_...
# ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------------------
# Model — MUST match the provider above.
#
# The model has to be both vision-capable and able to do tool / function
# calling; the pipeline forces a structured tool call on every request, so a
# text-only or tool-less model fails immediately.
#
#   Groq       → a Groq vision model id (see https://console.groq.com/docs/models)
#   Anthropic  → e.g. claude-sonnet-5-5
#
# There is no safe default here: config.py ships a Claude id, so if you set
# GROQ_API_KEY you must set DPA_MODEL too or every audit errors out.
# ---------------------------------------------------------------------------
DPA_MODEL=

# ---------------------------------------------------------------------------
# Pinned for reproducible evaluation runs. Do not change mid-experiment —
# every number already collected becomes incomparable.
# ---------------------------------------------------------------------------
DPA_TEMPERATURE=0
